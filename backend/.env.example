# ============================================================
# MONSTORE / AUREN STORE — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT expiration (e.g., "7d", "24h", "1h")
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
# The URL of your frontend (used for CORS and email links)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# Admin (seed creates an admin user if these are set)
# ------------------------------------------------------------
ADMIN_EMAIL=admin@monsstore.ma
ADMIN_PASSWORD=ChangeThisPassword123!
